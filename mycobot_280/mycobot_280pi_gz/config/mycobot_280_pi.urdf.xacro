<?xml version="1.0"?>
<!--
  Self-contained URDF xacro for mycobot_280_pi with Gazebo Ignition support.
  Collision geometry disabled — visuals + inertials only.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="firefighter">

  <!-- ros2_control with IgnitionSystem -->
  <xacro:include filename="mycobot_280_pi.ros2_control.xacro" />
  <xacro:mycobot_280_pi_ros2_control name="IgnitionSystem"/>

  <!-- ign_ros2_control Gazebo plugin -->
  <gazebo>
    <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(find mycobot_280pi_gz)/config/ros2_controllers.yaml</parameters>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- ===== LINKS ===== -->

  <link name="g_base">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/G_base.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.03" rpy="0 0 1.5708"/>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.015"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <link name="joint1">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/joint1_pi.dae"/>
      </geometry>
      <origin xyz="0.0 0 0" rpy="0 0 0"/>
    </visual>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0.07"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="joint2">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/joint2.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.06096" rpy="0 0 -1.5708"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="-0.055 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="joint3">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/joint3.dae"/>
      </geometry>
      <origin xyz="0.0 0 0.03256" rpy="0 -1.5708 0"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="-0.048 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="joint4">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/joint4.dae"/>
      </geometry>
      <origin xyz="0.0 0 0.03056" rpy="0 -1.5708 0"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 -0.036 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="joint5">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/joint5.dae"/>
      </geometry>
      <origin xyz="0.0 -0.001 -0.0345" rpy="0 -1.5708 1.5708"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 -0.02"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="joint6">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/joint6.dae"/>
      </geometry>
      <origin xyz="0 0.00 -0.038" rpy="0 0 0"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <link name="joint6_flange">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_pi/joint7.dae"/>
      </geometry>
      <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- ===== JOINTS ===== -->

  <joint name="g_base_to_joint1" type="fixed">
    <axis xyz="0 0 0"/>
    <limit effort="1000.0" lower="-3.14" upper="3.14159" velocity="0"/>
    <parent link="g_base"/>
    <child link="joint1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.9321" upper="2.9321" velocity="3.14"/>
    <parent link="joint1"/>
    <child link="joint2"/>
    <origin xyz="0 0 0.13956" rpy="0 0 0"/>
  </joint>

  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.4434" upper="2.4434" velocity="3.14"/>
    <parent link="joint2"/>
    <child link="joint3"/>
    <origin xyz="0 0 -0.001" rpy="0 1.5708 -1.5708"/>
  </joint>

  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.6179" upper="2.6179" velocity="3.14"/>
    <parent link="joint3"/>
    <child link="joint4"/>
    <origin xyz="-0.1104 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.6179" upper="2.6179" velocity="3.14"/>
    <parent link="joint4"/>
    <child link="joint5"/>
    <origin xyz="-0.096 0 0.06462" rpy="0 0 -1.5708"/>
  </joint>

  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.7052" upper="2.7925" velocity="3.14"/>
    <parent link="joint5"/>
    <child link="joint6"/>
    <origin xyz="0 -0.07318 -0.001" rpy="1.5708 -1.5708 0"/>
  </joint>

  <joint name="joint6output_to_joint6" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-3.14159" upper="3.14159" velocity="3.14"/>
    <parent link="joint6"/>
    <child link="joint6_flange"/>
    <origin xyz="0 0.0456 0" rpy="-1.5708 0 0"/>
  </joint>

  <!-- ===== GAZEBO MATERIALS ===== -->

  <gazebo reference="g_base"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="joint1"><material>Gazebo/White</material></gazebo>
  <gazebo reference="joint2"><material>Gazebo/White</material></gazebo>
  <gazebo reference="joint3"><material>Gazebo/White</material></gazebo>
  <gazebo reference="joint4"><material>Gazebo/White</material></gazebo>
  <gazebo reference="joint5"><material>Gazebo/White</material></gazebo>
  <gazebo reference="joint6"><material>Gazebo/White</material></gazebo>
  <gazebo reference="joint6_flange"><material>Gazebo/DarkGrey</material></gazebo>

</robot>
